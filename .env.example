# =============================================================================
# Code Review Assistant — Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Application
APP_NAME=Code Review Assistant
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
API_V1_PREFIX=/api/v1

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql://cra_user:cra_password@postgres:5432/code_review_assistant
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT (used in Phase 1+)
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI (used in Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# GitHub OAuth (used in Phase 2+)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
FRONTEND_URL=http://localhost:3000
